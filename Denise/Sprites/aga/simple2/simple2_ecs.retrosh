# Regression testing script for vAmiga
# Dirk W. Hoffmann, 2026

# Setup the test environment
# ECS Agnus, OCS Denise
regression setup A500_ECS_1MB /tmp/kick13.rom

# Run the test
regression run /tmp/Sprites_aga_simple2_ecs.adf
wait 9 seconds

# Exit with a screenshot
screenshot save Sprites_aga_simple2_ecs
