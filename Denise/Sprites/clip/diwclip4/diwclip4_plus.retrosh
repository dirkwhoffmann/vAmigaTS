# Regression testing script for vAmiga
# Dirk W. Hoffmann, 2026

# Setup the test environment
# A500_PLUS_1MB: ECS Denise -- BRDRBLNK and super hires both work
regression setup A500_PLUS_1MB /tmp/kick13.rom

# Run the test
regression run /tmp/diwclip4_plus.adf
wait 9 seconds

# Exit with a screenshot
screenshot save diwclip4_plus
