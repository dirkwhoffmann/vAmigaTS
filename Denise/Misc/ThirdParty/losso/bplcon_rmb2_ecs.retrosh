# Regression testing script for vAmiga
# Dirk W. Hoffmann, 2022

# Setup the test environment
regression setup A500_ECS_1MB /tmp/kick13.rom

# Run the test
regression run /tmp/Misc_ThirdParty_bplcon_rmb2_ecs.adf
wait 16 seconds

# Press the right mouse button
mouse1 press right
wait 2 seconds

# Exit with a screensht
screenshot set cutout x1=196 y1=36 x2=908 y2=312
screenshot save Misc_ThirdParty_bplcon_rmb2_ecs
