# Regression testing script for vAmiga
# Dirk W. Hoffmann, 2021

# Setup the test environment
regression setup A500_OCS_1MB /tmp/kick13.rom

# Run the test
regression run /tmp/deniseid_ocs.adf
wait 9 seconds

# Exit with a screensht
screenshot set cutout x1=196 y1=32 x2=908 y2=314
screenshot save deniseid_ocs
