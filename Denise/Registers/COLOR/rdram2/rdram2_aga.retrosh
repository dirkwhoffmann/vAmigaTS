# Regression testing script for vAmiga
# Dirk W. Hoffmann

# Setup the test environment
# A1200_2MB: AGA Denise -- RDRAM is decoded only here
regression setup A1200_2MB /tmp/kick13.rom

# Run the test
regression run /tmp/Registers_COLOR_rdram2_aga.adf
wait 9 seconds

# Exit with a screenshot
screenshot save Registers_COLOR_rdram2_aga
