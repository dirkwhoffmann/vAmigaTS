# Regression testing script for vAmiga
# Dirk W. Hoffmann, 2026

# Setup the test environment
# AGA Agnus, AGA Denise -- the configuration this variant is for
regression setup A1200_2MB /tmp/kick13.rom

# Run the test
regression run /tmp/rulevern2_aga.adf
wait 9 seconds

# Exit with a screenshot
screenshot save rulevern2_aga
