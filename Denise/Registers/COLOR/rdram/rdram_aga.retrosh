# Regression testing script for vAmiga
# Dirk W. Hoffmann, 2026

# Setup the test environment
# AGA Agnus, AGA Denise -- RDRAM exists here
regression setup A1200_2MB /tmp/kick13.rom

# Run the test
regression run /tmp/Registers_COLOR_rdram_aga.adf
wait 9 seconds

# Exit with a screenshot
screenshot save Registers_COLOR_rdram_aga
