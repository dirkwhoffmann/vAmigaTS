# Regression testing script for vAmiga
# Dirk W. Hoffmann

# Setup the test environment
# A500_PLUS_1MB: ECS Denise -- BRDRBLNK active
regression setup A500_PLUS_1MB /tmp/kick13.rom

# Run the test
regression run /tmp/brdrblnk2_plus.adf
wait 9 seconds

# Exit with a screensht
screenshot save brdrblnk2_plus
