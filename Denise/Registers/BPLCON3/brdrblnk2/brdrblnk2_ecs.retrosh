# Regression testing script for vAmiga
# Dirk W. Hoffmann

# Setup the test environment
# A500_ECS_1MB: OCS Denise -- BRDRBLNK has no effect (negative control)
regression setup A500_ECS_1MB /tmp/kick13.rom

# Run the test
regression run /tmp/Registers_BPLCON3_brdrblnk2_ecs.adf
wait 9 seconds

# Exit with a screensht
screenshot save Registers_BPLCON3_brdrblnk2_ecs
