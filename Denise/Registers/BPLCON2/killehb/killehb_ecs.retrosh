# Regression testing script for vAmiga
# Dirk W. Hoffmann

# Setup the test environment
# A500_ECS_1MB: OCS Denise -- no KILLEHB, EHB always active
regression setup A500_ECS_1MB /tmp/kick13.rom

# Run the test
regression run /tmp/Registers_BPLCON2_killehb_ecs.adf
wait 9 seconds

# Exit with a screenshot
screenshot save Registers_BPLCON2_killehb_ecs
