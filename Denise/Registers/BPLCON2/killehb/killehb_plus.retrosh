# Regression testing script for vAmiga
# Dirk W. Hoffmann

# Setup the test environment
# A500_PLUS_1MB: ECS Denise -- KILLEHB honoured
regression setup A500_PLUS_1MB /tmp/kick13.rom

# Run the test
regression run /tmp/Registers_BPLCON2_killehb_plus.adf
wait 9 seconds

# Exit with a screensht
screenshot save Registers_BPLCON2_killehb_plus
