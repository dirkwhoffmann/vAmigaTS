# Regression testing script for vAmiga
# Dirk W. Hoffmann

# Setup the test environment
# A1200_2MB: AGA Denise -- the only chipset with super hires and COLOR33/COLOR63
regression setup A1200_2MB /tmp/kick13.rom

# Run the test
regression run /tmp/Registers_BPLCON2_killehb2_aga.adf
wait 9 seconds

# Exit with a screenshot
screenshot save Registers_BPLCON2_killehb2_aga
