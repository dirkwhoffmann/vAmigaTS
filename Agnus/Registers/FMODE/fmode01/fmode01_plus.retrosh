# Regression testing script for vAmiga
# Dirk W. Hoffmann, 2026

# Setup the test environment
# ECS Agnus, ECS Denise
regression setup A500_PLUS_1MB /tmp/kick13.rom

# Run the test
regression run /tmp/Registers_FMODE_fmode01_plus.adf
wait 9 seconds

# Exit with a screenshot
screenshot save Registers_FMODE_fmode01_plus
