# Regression testing script for vAmiga
# Dirk W. Hoffmann, 2026

# Setup the test environment
# AGA Agnus, AGA Denise -- FMODE is an AGA register
regression setup A1200_2MB /tmp/kick13.rom

# Run the test
regression run /tmp/DDF_AGADDF_agaddf5.adf
wait 9 seconds

# Exit with a screenshot
screenshot save DDF_AGADDF_agaddf5
