# Regression testing script for vAmiga
# Dirk W. Hoffmann, 2022

# Setup the test environment
regression setup A500_OCS_1MB /tmp/kick13.rom

# Run the test
regression run /tmp/Copper_lc_lc1b_ocs.adf
wait 9 seconds

# Exit with a screenshot
screenshot set cutout x1=300 y1=26 x2=912 y2=311
screenshot save Copper_lc_lc1b_ocs
