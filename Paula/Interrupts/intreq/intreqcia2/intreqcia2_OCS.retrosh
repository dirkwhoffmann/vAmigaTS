# Regression testing script for vAmiga
# Dirk W. Hoffmann, 2022

# Setup the test environment
regression setup A500_OCS_1MB /tmp/kick13.rom

# Run the test
regression run /tmp/Interrupts_intreq_intreqcia2_OCS.adf
wait 9 seconds

# Exit with a screenshot
screenshot set cutout x1=196 y1=132 x2=908 y2=314
screenshot save Interrupts_intreq_intreqcia2_OCS
